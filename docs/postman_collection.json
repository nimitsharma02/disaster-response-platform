    {
      "name": "4. Reports \u2014 external integration + caching",
      "description": "Aggregates two mock providers with different payload shapes. Watch the X-Cache header: MISS on the first call, HIT on the second.",
      "item": [
        {
          "name": "Reports (first call \u2014 MISS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/disasters/{{disasterId}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "disasters",
                "{{disasterId}}",
                "reports"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"cache reports MISS\", () =>",
                  "    pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"MISS\"));",
                  "pm.test(\"both providers normalised into one shape\", () => {",
                  "    const sources = new Set(pm.response.json().items.map(i => i.source));",
                  "    pm.expect(sources.has(\"social\") || sources.has(\"official\")).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reports (second call \u2014 HIT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/disasters/{{disasterId}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "disasters",
                "{{disasterId}}",
                "reports"
              ]
            },
            "description": "No external call is made; served from cache."
          },
          "response": [],
          "event": [
