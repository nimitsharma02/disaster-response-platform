# ---------------------------------------------------------------------------
# Copy to `.env` (`cp .env.example .env`). The defaults below are LOCAL-ONLY
# development values and are safe to commit. Never put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console (human readable) | json (for log shippers)
API_PORT=8000
CORS_ORIGINS=*                 # comma-separated list; lock this down in production

# --- Postgres / PostGIS ----------------------------------------------------
POSTGRES_USER=drp
POSTGRES_PASSWORD=drp_local_password
POSTGRES_DB=disaster_response
POSTGRES_PORT=5432
# Host-side URL. docker-compose overrides the host to `db` inside the network.
DATABASE_URL=postgresql+asyncpg://drp:drp_local_password@localhost:5432/disaster_response
TEST_DATABASE_URL=postgresql+asyncpg://drp:drp_local_password@localhost:5432/disaster_response_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# If Redis is unreachable the app transparently falls back to an in-process cache
# and an in-process event bus, so it still boots. Set to false to fail loudly instead.
CACHE_ALLOW_MEMORY_FALLBACK=true

# --- Authentication --------------------------------------------------------
# CHANGE THIS. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
# Passwords for the seeded demo accounts (admin / contributor / responder).
SEED_ADMIN_PASSWORD=admin123
SEED_CONTRIBUTOR_PASSWORD=contributor123
SEED_RESPONDER_PASSWORD=responder123

# --- External services -----------------------------------------------------
# Mock social-media + official-bulletin provider (runs as its own container).
SOCIAL_API_BASE_URL=http://localhost:9000
OFFICIAL_API_BASE_URL=http://localhost:9000
MOCK_PORT=9000
# Fraction of mock requests that fail on purpose, for demoing resilience (0.0 - 1.0).
MOCK_FAILURE_RATE=0.0
MOCK_LATENCY_MS=120

# OpenStreetMap Nominatim geocoding. Free, NO API KEY REQUIRED.
# Their usage policy requires an identifying User-Agent and max 1 request/second.
GEOCODER_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=disaster-response-platform/1.0 (contact: you@example.com)
NOMINATIM_RATE_LIMIT_PER_SEC=1

# OPTIONAL. If set, an LLM extracts the place name from the description.
# If unset, a deterministic rule-based extractor is used instead - the app is
# fully functional without any key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Resilience ------------------------------------------------------------
HTTP_CONNECT_TIMEOUT_S=2.0
HTTP_READ_TIMEOUT_S=5.0
HTTP_MAX_RETRIES=2
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_S=30

# --- Cache TTLs (seconds) --------------------------------------------------
CACHE_TTL_GEOCODE=604800       # 7 days  - a place's coordinates effectively never move
CACHE_TTL_PLACE_EXTRACT=86400  # 24 h    - deterministic for a given description
CACHE_TTL_REPORTS=300          # 5 min   - social chatter must stay reasonably fresh
CACHE_TTL_OFFICIAL=900         # 15 min  - official bulletins change slowly
CACHE_STALE_GRACE=3600         # 1 h     - how long stale data may be served if origin is down
CACHE_L1_TTL=30                # in-process tier, deliberately short

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_S=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_S=60
